      "name": "User Row",
      "kind": "nav",
      "refersTo": "user-row",
      "description": "Sidebar button row with pastel initial chip; fills red when selected.",
      "html": "<div style=\"display:flex;flex-direction:column;gap:4px;width:288px\"><button class=\"ds-user-row\"><span class=\"ds-chip\">LG</span><span class=\"ds-user-text\"><span class=\"ds-user-name\">Leanne Graham</span><span class=\"ds-user-email\">sincere@april.biz</span></span></button><button class=\"ds-user-row ds-selected\"><span class=\"ds-chip ds-chip-white\">EH</span><span class=\"ds-user-text\"><span class=\"ds-user-name\">Ervin Howell</span><span class=\"ds-user-email ds-email-sel\">shanna@melissa.tv</span></span></button></div>",
      "css": ".ds-user-row{display:flex;align-items:center;gap:12px;width:100%;padding:8px 12px 8px 8px;border:0;border-radius:25px;background:transparent;color:var(--color-foreground,#1c2230);text-align:left;font-family:'Geist Variable',sans-serif;cursor:pointer;transition:background-color .2s}.ds-user-row:hover{background:oklch(0.97 0 0)}.ds-user-row:focus-visible{outline:0;box-shadow:0 0 0 3px oklch(0.55 0.205 28 / .5)}.ds-selected,.ds-selected:hover{background:oklch(0.55 0.205 28);color:#fff}.ds-chip{display:flex;align-items:center;justify-content:center;width:40px;height:40px;flex-shrink:0;border-radius:20px;background:oklch(0.91 0.07 88);color:oklch(0.2 0.02 260);font-size:14px;font-weight:500}.ds-chip-white{background:#fff}.ds-user-text{display:flex;flex-direction:column;min-width:0}.ds-user-name{font-size:14px;font-weight:500}.ds-user-email{font-size:12px;color:oklch(0.48 0.01 260)}.ds-email-sel{color:#fff}"
    },
