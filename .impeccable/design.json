      "css": ".ds-search{position:relative;width:288px;color:oklch(0.48 0.01 260)}.ds-search svg{position:absolute;top:50%;left:12px;transform:translateY(-50%);pointer-events:none}.ds-search-input{box-sizing:border-box;width:100%;height:40px;padding:0 12px 0 36px;border:1px solid oklch(0.922 0 0);border-radius:20px;background:oklch(0.97 0 0 / .6);color:oklch(0.2 0.02 260);font:14px 'Geist Variable',sans-serif;outline:0}.ds-search-input:focus-visible{border-color:oklch(0.55 0.205 28);box-shadow:0 0 0 3px oklch(0.55 0.205 28 / .5)}"
