    {
      "name": "Post Tile",
      "kind": "card",
      "refersTo": "post-tile",
      "description": "Flat pastel tile with oversized light numeral, title, and body; one per post, cycling four colors.",
      "html": "<div style=\"display:grid;grid-template-columns:repeat(2,240px);gap:12px\"><article class=\"ds-tile ds-t1\"><div class=\"ds-tile-head\"><span class=\"ds-num\">01</span></div><h3 class=\"ds-tile-title\">Sunt aut facere repellat</h3><p class=\"ds-tile-body\">Quia et suscipit suscipit recusandae consequuntur expedita.</p></article><article class=\"ds-tile ds-t2\"><div class=\"ds-tile-head\"><span class=\"ds-num\">02</span><span class=\"ds-new\">New</span></div><h3 class=\"ds-tile-title\">Qui est esse</h3><p class=\"ds-tile-body\">Est rerum tempore vitae sequi sint nihil reprehenderit.</p></article></div>",
      "css": ".ds-tile{box-sizing:border-box;display:flex;flex-direction:column;gap:12px;padding:20px;border-radius:31px;color:oklch(0.2 0.02 260);font-family:'Geist Variable',sans-serif}.ds-t1{background:oklch(0.91 0.07 88)}.ds-t2{background:oklch(0.84 0.065 290)}.ds-tile-head{display:flex;justify-content:space-between;align-items:flex-start}.ds-num{font-size:72px;line-height:1;font-weight:300}.ds-new{padding:2px 8px;border-radius:9999px;background:#fff;font-size:12px;font-weight:500}.ds-tile-title{margin:0;font-size:16px;line-height:1.35;font-weight:600}.ds-tile-body{margin:0;font-size:14px;line-height:1.625;color:oklch(0.36 0.03 260)}"
    },
    {
      "name": "Composer Tile",
      "kind": "card",
      "refersTo": "composer-tile",
      "description": "The one red tile: next-number in huge light numerals, white fields, white pill Publish button.",
      "html": "<section class=\"ds-composer\"><div class=\"ds-comp-head\"><div><h3 class=\"ds-comp-title\">New post</h3><p class=\"ds-comp-sub\">It appears first in the list once published.</p></div><span class=\"ds-comp-num\">11</span></div><label class=\"ds-comp-label\">Title<input class=\"ds-comp-field\" placeholder=\"Give your post a title\"></label><label class=\"ds-comp-label\">Body<textarea class=\"ds-comp-field ds-comp-area\" rows=\"3\" placeholder=\"What do you want to say?\"></textarea></label><button class=\"ds-comp-btn\">Publish</button></section>",
      "css": ".ds-composer{box-sizing:border-box;display:flex;flex-direction:column;gap:16px;width:480px;padding:20px 24px;border-radius:31px;background:oklch(0.55 0.205 28);color:#fff;font-family:'Geist Variable',sans-serif}.ds-comp-head{display:flex;justify-content:space-between;align-items:flex-start;gap:16px}.ds-comp-title{margin:0;font-size:20px;font-weight:600}.ds-comp-sub{margin:4px 0 0;font-size:14px}.ds-comp-num{font-size:96px;line-height:1;font-weight:300}.ds-comp-label{display:flex;flex-direction:column;gap:6px;font-size:14px;font-weight:500}.ds-comp-field{box-sizing:border-box;width:100%;padding:8px 12px;border:0;border-radius:20px;background:#fff;color:oklch(0.2 0.02 260);font:14px 'Geist Variable',sans-serif;outline:0}.ds-comp-field:not(textarea){height:40px}.ds-comp-field::placeholder{color:oklch(0.36 0.03 260 / .8)}.ds-comp-field:focus-visible{box-shadow:0 0 0 3px rgba(255,255,255,.6)}.ds-comp-area{resize:vertical}.ds-comp-btn{align-self:flex-start;height:40px;padding:0 20px;border:0;border-radius:9999px;background:#fff;color:oklch(0.55 0.205 28);font:500 14px 'Geist Variable',sans-serif;cursor:pointer;transition:background-color .2s}.ds-comp-btn:hover{background:rgba(255,255,255,.9)}.ds-comp-btn:focus-visible{outline:0;box-shadow:0 0 0 3px rgba(255,255,255,.6)}"
