  "narrative": {
    "northStar": "The Promo Calendar",
    "overview": "A utility tool dressed as a holiday promo calendar. Posts become numbered candy tiles and the composer is the one red tile that matters. Two white, deeply rounded panels float on an aqua-mint canvas like phones laid on a table: users on the left, posts on the right, each scrolling on its own. The system rejects the default grey admin list with a single accent.\n\nThe mood is cheerful, tactile, and confident, but the layout stays plain and legible. All personality lives in color and one typographic gesture: oversized light numerals (\"01\", \"02\") that turn a list of posts into a calendar grid. Everything else is Geist at ordinary sizes with near-black ink. Shadows are limited to one soft lift under each panel. Tiles are flat color.",
    "keyCharacteristics": [
      "Aqua-mint canvas with two floating white panels; the canvas is the only large tinted field.",
      "Four pastel tiles (butter, lavender, sky, mint) cycle by number; one saturated tomato red carries every action and selection.",
      "Oversized light numerals are the only display gesture.",
      "Flat tiles, large radii (28px panels, about 31px tiles), no gradients, no hard shadows.",
      "Motion only on state: 150 to 300 ms transitions, one entrance for a newly published post."
    ],
    "rules": [
      {
        "name": "The One Red Rule",
        "body": "Tomato red marks the thing you act on or are in: the composer, the selected user, the headline of that user, and the primary focus ring. No second saturated hue exists, and red never decorates.",
        "section": "colors"
      },
      {
        "name": "The Tile Cycle Rule",
        "body": "Pastels cycle butter, lavender, sky, mint by number. Never pick a tile color by meaning or status; the cycle is the whole logic.",
        "section": "colors"
      },
      {
        "name": "The Red-Tile Inversion Rule",
        "body": "On the red tile, controls invert to white: white fields, white button with red text, white focus rings, white error text. The theme's destructive red would vanish there, so errors on red are signaled with a white ring and weight, never with red.",
        "section": "colors"
      },
      {
        "name": "The Numeral Only Rule",
        "body": "Large display type is for numerals. Words never get the display treatment beyond the bold headline.",
        "section": "typography"
      },
      {
        "name": "The One Lift Rule",
        "body": "Only panels lift. A tile that needs emphasis changes color, not elevation.",
        "section": "elevation"
      },
      {
        "name": "The Step-Down Rule",
        "body": "A child inside a rounded container uses the next smaller radius rung, never the same one.",
        "section": "shapes"
      }
    ],
    "dos": [
      "Do keep tomato red (oklch(0.55 0.205 28)) as the only saturated hue, reserved for the composer, selection, the user headline, and focus.",
      "Do cycle the four pastels in order by number and set text on them in Tile Ink or Tile Ink Soft.",
      "Do use large light (300) numerals as the display gesture, padded to two digits.",
      "Do invert controls to white on the red tile, as the composer does.",
      "Do build with the shadcn primitives in `src/components/ui` and restyle through className at the usage site.",
      "Do keep panels independently scrollable and the shell at viewport height.",
      "Do limit transitions to 150 to 300 ms state changes, and wrap entrances in `motion-safe`."
    ],
    "donts": [
      "Don't return to a grey admin list with a single accent.",
      "Don't add gradients, hard offset shadows, or shadows on tiles, fields, and buttons.",
      "Don't use destructive red for errors that sit on the red composer tile; it disappears.",
      "Don't use pastel text colors or put Muted Ink on a pastel tile; use Tile Ink Soft.",
      "Don't assign tile colors by status or meaning.",
      "Don't edit shadcn primitives in place."
    ]
  }
}
